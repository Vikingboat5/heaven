[
  {
    "id": "myth:moon_palace",
    "pack": "myth_shanhaijing_east",
    "name": "月宫",
    "min_level": 1,
    "time_gate": null,
    "background": "月面上的宫殿：白玉台阶、终年不散的桂花香、银白色云雾缭绕。宫里有一只捣药的白兔（红眼睛、系着小围裙），还有一个高大的男人在砍一棵永远砍不倒的桂树。在这里能看到一颗蓝色的大圆球悬在天上。",
    "postcard_scene": "它趴在白玉台阶上, 前爪捧着一块桂花糕啃了一口, 旁边捣药的白兔歪头看它, 背景是银白宫殿和天上的蓝色大圆球",
    "cast": [
      {"id": "npc:jade_rabbit", "desc_words": "捣药的白兔, 红眼睛, 系着小围裙", "interactions": ["receive_gift", "exchange"]},
      {"id": "npc:wugang", "desc_words": "砍一棵永远砍不倒的桂树的高大男人", "interactions": ["meet_character", "help"]}
    ],
    "atmosphere": "桂花香/银白色/安静",
    "fallback_item": "moon_laurel_leaf",
    "loot_table": [
      {"item": "osmanthus_cake", "weight": 28},
      {"item": "cloud_candy", "weight": 20},
      {"item": "moon_laurel_leaf", "weight": 22},
      {"item": "moon_herb", "weight": 12},
      {"item": "star_sand", "weight": 10},
      {"item": "rabbit_floss", "weight": 5},
      {"item": "moonstone", "weight": 2},
      {"item": "moon_jade", "weight": 1}
    ],
    "event_deck": {
      "encounter": [
        {"text": "遇到一只捣药的白兔, 红眼睛, 系着小围裙, 药臼里飘出安神的香气", "type": "meet_character", "npc": "npc:jade_rabbit", "exp": 14},
        {"text": "看到一个高大的男人在砍一棵桂树, 砍开的口子转眼就长好了, 他擦擦汗接着砍", "type": "meet_character", "npc": "npc:wugang", "exp": 12},
        {"text": "捣药的白兔注意到了我, 停下手里的活, 歪着头看了我好久好久", "type": "meet_character", "npc": "npc:jade_rabbit", "exp": 12}
      ],
      "food": [
        {"text": "桂花香把我引到一张石桌前, 上面有还冒热气的{item}", "type": "taste", "item": "osmanthus_cake", "exp": 8},
        {"text": "尝了一口云朵做成的糖, 甜得眯起眼睛, 像在吃一缕雾", "type": "taste", "item": "cloud_candy", "exp": 8},
        {"text": "捣药的白兔分给我一小碗药草茶, 暖暖的, 浑身都松快了", "type": "taste", "exp": 10}
      ],
      "collect": [
        {"text": "在白玉台阶的缝隙里找到了{item}", "type": "find_item", "loot": true, "exp": 9},
        {"text": "桂树的落叶打着旋儿飘下来, 我接住了最亮的一片", "type": "find_item", "item": "moon_laurel_leaf", "exp": 8},
        {"text": "跟着一粒发光的浮尘走了好久, 拾到了一小把{item}", "type": "find_item", "item": "star_sand", "exp": 10}
      ],
      "learn": [
        {"text": "看白兔捣药看入了迷, 偷偷学会了那个节奏: 咚, 咚咚", "type": "learn", "exp": 12},
        {"text": "学云彩变换形状, 把自己团成了一只圆滚滚的云", "type": "learn", "exp": 10}
      ],
      "help": [
        {"text": "帮砍树的男人把散落的桂枝拢成一堆, 他冲我感激地点了点头", "type": "help", "npc": "npc:wugang", "receive": true, "exp": 12},
        {"text": "药臼太重了, 我帮白兔扶稳了一把, 它塞给我一点谢礼", "type": "help", "npc": "npc:jade_rabbit", "receive": true, "exp": 12}
      ],
      "thrill": [
        {"text": "云雾突然散开, 脚下差点踩空, 幸好抱住了一根玉栏杆", "type": "danger_safe", "exp": 12},
        {"text": "一阵银色的风把我吹得原地转了三圈, 晕乎乎的但没事", "type": "danger_safe", "exp": 10}
      ],
      "treasure": [
        {"text": "在宫殿的阴影里, 发现一块把月光凝住的石头!", "type": "treasure", "loot_rare": true, "exp": 16},
        {"text": "桂树最粗的根底下, 埋着一块凉凉的玉!", "type": "treasure", "loot_rare": true, "exp": 18}
      ],
      "wander": [
        {"text": "在云雾里散步, 每走一步都漾开一圈银白色的波纹", "type": "scenery", "exp": 6},
        {"text": "趴在栏杆上看那颗蓝色的大圆球, 看得出神", "type": "scenery", "exp": 6},
        {"text": "桂花的香气一层一层飘过来, 闻着闻着就忘了时间", "type": "scenery", "exp": 5}
      ],
      "social": [
        {"text": "一群发光的小精灵围着我转圈, 跟我玩了一会儿捉迷藏", "type": "meet_creature", "exp": 8},
        {"text": "一只云做的小鹿蹭了蹭我, 留下一身软软的雾气", "type": "meet_creature", "exp": 8}
      ],
      "rest": [
        {"text": "在桂花树影里蜷成一团, 安安静静睡了一觉", "type": "rest_nothing", "exp": 4}
      ]
    }
  },
