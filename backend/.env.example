# ---- LLM (火山引擎 Ark, OpenAI 兼容协议) ----
# POC 阶段: 使用环境已有 plan 代理 (kimi-k3)
# 生产阶段: 替换为标准 Ark key + v3 端点 + 豆包模型接入点 ID
ARK_API_KEY=your-ark-api-key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL_STANDARD=doubao-pro-32k        # 实时对话档
LLM_MODEL_LITE=doubao-lite-32k           # 日志润色/事实抽取档
LLM_TIMEOUT_SECONDS=60

# ---- 生图 (Agent Plan 视觉端点) ----
# PETGEN_MODE=live  正常: 孵化时调用生图管线生成专属形象
# PETGEN_MODE=reuse 生图套餐不可用: 复用素材库已有形象(static/pets/_library)
PETGEN_MODE=live

# ---- 成本熔断 ----
LLM_DAILY_TOKEN_BUDGET_PER_PET=20000     # 单宠物每日 token 配额
LLM_DAILY_TOKEN_BUDGET_GLOBAL=10000000   # 全局每日闸口

# ---- 数据层 ----
DATABASE_URL=postgresql+psycopg://petparadise:petparadise_dev@localhost:5432/pet_paradise
REDIS_URL=redis://localhost:6379/0

# ---- 应用 ----
APP_ENV=dev
JWT_SECRET=change-me-in-prod
